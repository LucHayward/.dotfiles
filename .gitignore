.DS_Store

# ~/.claude links to .claude/, so Claude's runtime state lives there too.
# Track only the curated files; history, sessions and caches stay local.
.claude/*
!.claude/CLAUDE.md
!.claude/README.md
!.claude/settings.json
!.claude/statusline.sh
!.claude/local.claude-settings-repair.plist
!.claude/rules/
.claude/rules/*
!.claude/rules/amazon-builder-context-do-not-delete.md
!.claude/rules/amazon-production-safety-do-not-delete.md

# Runtime lock created while Codex rewrites its live configuration
.codex/config.toml.lock
