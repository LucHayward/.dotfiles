{
  "awsCredentialExport": "~/.toolbox/bin/claude default-credential-export",
  "env": {
    "AWS_EC2_METADATA_DISABLED": "true",
    "AWS_REGION": "us-west-2"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "cship"
  },
  "enabledPlugins": {
    "AmazonBuilderCoreAIAgents-runtime-configuration-assistant@aim": true,
    "AmazonBuilderCoreAIAgents-pipeline-assistant@aim": true,
    "AmazonBuilderCoreAIAgents-core@aim": true,
    "AIPowerUserCapabilities-comms@aim": true,
    "AIPowerUserCapabilities-research@aim": true,
    "AIPowerUserCapabilities-core-dev@aim": true,
    "AIPowerUserCapabilities-code-review@aim": true,
    "AIPowerUserCapabilities-writing@aim": true,
    "ChorusAIM-all@aim": true,
    "MfArbalestAICapabilities-arbalest@aim": true
  },
  "modelOverrides": {
    "claude-opus-4-7[1m]": "global.anthropic.claude-opus-4-7[1m]",
    "claude-opus-4-7": "global.anthropic.claude-opus-4-7",
    "claude-opus-4-8[1m]": "arn:aws:bedrock:us-west-2:175342148895:default-prompt-router/anthropic-claude-balanced:1[1m]",
    "claude-opus-4-8": "arn:aws:bedrock:us-west-2:175342148895:default-prompt-router/anthropic-claude-balanced:1",
    "claude-opus-5[1m]": "global.anthropic.claude-opus-5[1m]",
    "claude-opus-5": "global.anthropic.claude-opus-5",
    "claude-opus-5-5[1m]": "global.anthropic.claude-opus-5-5[1m]",
    "claude-opus-5-5": "global.anthropic.claude-opus-5-5",
    "claude-sonnet-4-6": "global.anthropic.claude-sonnet-4-6",
    "claude-sonnet-4-6[1m]": "global.anthropic.claude-sonnet-4-6[1m]",
    "claude-sonnet-5": "global.anthropic.claude-sonnet-5",
    "claude-sonnet-5-5[1m]": "global.anthropic.claude-sonnet-5-5[1m]",
    "claude-sonnet-5-5": "global.anthropic.claude-sonnet-5-5",
    "claude-fable-5": "global.anthropic.claude-fable-5[1m]",
    "claude-fable-5[1m]": "global.anthropic.claude-fable-5[1m]",
    "claude-haiku-4-5": "global.anthropic.claude-haiku-4-5-20251001-v1:0"
  },
  "enforceAvailableModels": true,
  "model": "global.anthropic.claude-opus-5-5[1m]",
  "fallbackModel": [
    "global.anthropic.claude-opus-5[1m]",
    "global.anthropic.claude-opus-4-8[1m]",
    "global.anthropic.claude-opus-4-7[1m]"
  ]
}