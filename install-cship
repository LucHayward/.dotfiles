#!/bin/zsh
# Install or update cship from crates.io using the release's locked dependencies.
# Cargo skips installation when the latest release is already installed.

cargo_bin="${CARGO_HOME:-$HOME/.cargo}/bin/cargo"
if [[ ! -x "$cargo_bin" ]]; then
    cargo_bin="$(command -v cargo)" || {
        print -u2 "Cargo is missing. Install Rust with rustup, then rerun install-cship."
        exit 1
    }
fi

"$cargo_bin" install --locked cship
