#!/usr/bin/env python3
"""Keep ~/.claude linked to the dotfiles copy so every write lands in the repo.

Claude, Toolbox and AIM replace files with atomic renames, which breaks
per-file symlinks. Linking the whole directory makes those renames happen
inside the repo instead. The repo's .gitignore tracks only curated files.
"""

import argparse
import fcntl
import os
from pathlib import Path
import shutil
import subprocess
from datetime import datetime, timezone


HOME_DIR = Path.home()
LIVE = HOME_DIR / ".claude"
DOTFILES = Path(__file__).resolve().parent
REPO = DOTFILES / ".claude"
BACKUPS = REPO / "settings-backups"
LOCK = ".settings-sync.lock"
STAMP = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def is_linked():
    return LIVE.is_symlink() and LIVE.resolve() == REPO.resolve()


def points_into_repo(path):
    target = Path(os.path.realpath(path))
    return target == REPO.resolve() or REPO.resolve() in target.parents


def backup(path):
    BACKUPS.mkdir(mode=0o700, parents=True, exist_ok=True)
    destination = BACKUPS / f"{path.name}.{STAMP}"
    os.replace(path, destination)
    print(f"Backed up {path} -> {destination}")


def merge(source, destination):
    """Move live entries into the repo, keeping live files on conflict."""
    for entry in sorted(source.iterdir()):
        target = destination / entry.name
        if entry.name == LOCK or (entry.is_symlink() and (points_into_repo(entry) or not entry.exists())):
            # The old lock, per-file links into the repo, or dangling links.
            entry.unlink()
        elif entry.is_dir() and not entry.is_symlink() and target.is_dir() and not target.is_symlink():
            merge(entry, target)
            entry.rmdir()
        else:
            if os.path.lexists(target):
                backup(target)
            shutil.move(entry, target)


def link_live():
    temporary = LIVE.with_name(f".claude.link-{os.getpid()}")
    os.symlink(REPO, temporary)
    os.replace(temporary, LIVE)
    print(f"Linked {LIVE} -> {REPO}")


def repair():
    if is_linked():
        return
    if LIVE.is_symlink():
        raise ValueError(f"{LIVE} links elsewhere ({os.readlink(LIVE)}); fix it by hand")
    if LIVE.exists():
        merge(LIVE, REPO)
        # Swap the emptied directory for the link, then sweep anything a
        # running session wrote in between.
        stale = LIVE.with_name(f".claude.migrating-{STAMP}")
        os.replace(LIVE, stale)
        link_live()
        merge(stale, REPO)
        try:
            stale.rmdir()
        except OSError:
            print(f"Leftover entries remain in {stale}; rerun repair to sweep them")
    else:
        link_live()


def status():
    if is_linked():
        print(f"{LIVE} -> {REPO}", flush=True)
    else:
        print(f"{LIVE} is not linked to {REPO}; run: {__file__} repair", flush=True)
    subprocess.run(["git", "-C", DOTFILES, "status", "--short", "--", REPO], check=False)
    if not is_linked():
        raise SystemExit(1)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", nargs="?", default="status", choices=["repair", "status"])
    action = parser.parse_args().action
    if not REPO.is_dir() or REPO.is_symlink():
        raise ValueError(f"The repo copy must be a real directory: {REPO}")
    if action == "status":
        status()
        return
    with (REPO / LOCK).open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        repair()


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        raise SystemExit(f"claude-settings-sync: {error}")
